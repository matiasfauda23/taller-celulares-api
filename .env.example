NODE_ENV=development
PORT=3000
DATABASE_URL=<REQUIRED_POSTGRESQL_URL>
JWT_SECRET=<REQUIRED_UNIQUE_ACCESS_SECRET>
JWT_REFRESH_SECRET=<REQUIRED_UNIQUE_REFRESH_SECRET>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=<REQUIRED_JWT_ISSUER>
JWT_AUDIENCE=<REQUIRED_JWT_AUDIENCE>
BCRYPT_ROUNDS=12
PASSWORD_PEPPER=<REQUIRED_UNIQUE_PASSWORD_PEPPER>
CORS_ALLOWED_ORIGINS=http://localhost:3001
TRUST_PROXY=false
RATE_LIMIT_KEY_SECRET=<REQUIRED_UNIQUE_RATE_LIMIT_SECRET>
GLOBAL_RATE_LIMIT=100
REGISTER_ORIGIN_LIMIT=5
REGISTER_EMAIL_LIMIT=3
LOGIN_ORIGIN_LIMIT=20
LOGIN_EMAIL_LIMIT=5
