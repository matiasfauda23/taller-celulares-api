{
  "name": "taller-celulares-api",
  "version": "0.0.1",
  "description": "Backend API for a mobile phone repair shop",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "pnpm test:unit",
    "test:unit": "jest --config test/jest-unit.json --passWithNoTests",
    "test:integration": "jest --config test/jest-integration.json --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --passWithNoTests",
    "test:bench:auth": "jest --runInBand --passWithNoTests --testMatch '<rootDir>/test/bench/auth/**/*.bench-spec.ts'",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.3.0",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.16.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "jest": "30.2.0",
    "prettier": "3.8.2",
    "prisma": "7.10.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
